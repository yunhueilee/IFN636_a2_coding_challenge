# Backend configuration.
# Copy this file to `.env` in this same folder and fill in real values.
# `.env` is gitignored — never commit it.
MONGO_URI=mongodb+srv://INDEX:Kamijou_37312@cluster0.3sm3e5j.mongodb.net/taskmanager?appName=Cluster0
JWT_SECRET=2J8zqkP7VN6bxzg+Wy7DXCsd3Yx8mF3Bl0kch6HYtFs=
PORT=5001
# # MongoDB connection string (Atlas). Replace <user>, <password> and the cluster/db name.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# # Port the API listens on. Must be open as an inbound rule in the EC2 security group.
# PORT=5001

# # Secret used to sign JWTs. Generate a long random value, e.g.:
# #   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid (e.g. 7d, 12h, 3600s).
JWT_EXPIRES_IN=7d

# Seed accounts used by `npm run seed:admin` / `npm run seed:staff`.
ADMIN_MANAGER_EMAIL=manager@example.com
ADMIN_MANAGER_PASSWORD=YourStrongPassword1!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongPassword1!
